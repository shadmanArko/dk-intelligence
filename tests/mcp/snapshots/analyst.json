    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "cuisine_specialists_only": {
          "default": false,
          "description": "creators whose topics are South Asian food",
          "type": "boolean"
        },
        "include_examples": {
          "default": false,
          "type": "boolean"
        },
        "limit": {
          "default": 8,
          "maximum": 15,
          "minimum": 1,
          "type": "integer"
        },
        "size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "nano, micro, mid"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "meta": {
      "dk/contract": "1.0",
      "dk/sensitivity": "S2",
      "dk/server": "dk_models",
      "dk/trust": "untrusted"
    }
  },
  "funnel_status": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Use when: you need how website visits turn into orders: totals, top channels, posts followed by visits,\ncheckout friction, and the model's advice. Small order counts are shown as \"<5\".",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "section": {
          "default": "overview",
          "enum": [
            "overview",
            "channels",
            "posts",
            "friction"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "meta": {
      "dk/contract": "1.0",
      "dk/sensitivity": "S1",
      "dk/server": "dk_models",
      "dk/trust": "trusted"
    }
  },
  "get_facts": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Use when: you need a price, order deadline, delivery fee or area, pickup place or what we may claim.\nEvery fact has a status: only 'confirmed' may be stated; 'unknown' means don't state it. Never answer\nallergen questions: use the allergen_reply.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "keys": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "menu",
                  "ordering",
                  "fulfilment",
                  "claims_status"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "type": "object"
    },
    "meta": {
      "dk/contract": "1.0",
      "dk/sensitivity": "S0",
      "dk/server": "dk_brand",
      "dk/trust": "trusted"
    }
  },
  "get_sources": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Use when: you need the full source behind citations like [R-7KQ2M9XA] (place, district, date, rating, text)\nor want to prove a citation exists. Missing ids are listed under missing.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "cites": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array"
        },
        "include_text": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "cites"
      ],
      "type": "object"
    },
    "meta": {
      "dk/contract": "1.0",
      "dk/sensitivity": "S2",
      "dk/server": "dk_evidence",
      "dk/trust": "untrusted"
    }
  },
  "performance_by_feature": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Use when: you want every value of one feature on one platform, e.g. format or caption length: the median\nlift of a usual post, its interval, how many posts, and whether the difference from the other posts is clear.\nNot for: the short summary (use platform_playbook).",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "feature": {
          "description": "the post feature to break down",
          "enum": [
            "format",
            "weekday",
            "window",
            "caption_length",
            "first_line",
            "hashtags",
            "emojis",
            "asks_question",
            "calls_to_action",
            "german_first_line",
            "bilingual",
            "mentions_price"
          ],
          "type": "string"
        },
        "platform": {
          "enum": [
            "instagram",
            "facebook",
            "threads",
            "youtube",
            "tiktok"
          ],
          "type": "string"
        }
      },
      "required": [
        "platform",
        "feature"
      ],
      "type": "object"
    },
    "meta": {
      "dk/contract": "1.0",
      "dk/sensitivity": "S1",
      "dk/server": "dk_performance",
      "dk/trust": "trusted"
    }
  },
  "platform_playbook": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Use when: planning or writing for one platform and you want to know what our own past posts there support:\nwhat works, what hurts (each with its numbers, interval and post count), what a brand rule decides, and when\nthere is not enough data to say anything. Reach and engagement, never orders. Not for: checking a draft (use\nevaluate_drafts) or competitor or market trends (use trend_signals).",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "platform": {
          "enum": [
            "instagram",
            "facebook",
            "threads",
            "youtube",
            "tiktok"
          ],
          "type": "string"
        }
      },
      "required": [
        "platform"
      ],
      "type": "object"
    },
    "meta": {
      "dk/contract": "1.0",
      "dk/sensitivity": "S1",
      "dk/server": "dk_performance",
      "dk/trust": "trusted"
    }
  },
  "post_performance": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Use when: you want to know how one of our studio's published posts did, per platform, with what we knew about\nits idea (pillar, angle, hook). Posts are judged after 7 days. Not for: posts made by hand (they are in the\nplaybook's numbers, not listed by key).",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "post_key": {
          "description": "e.g. 2026w42-tue13-i1",
          "maxLength": 80,
          "type": "string"
        }
      },
      "required": [
        "post_key"
      ],
      "type": "object"
    },
    "meta": {
      "dk/contract": "1.0",
      "dk/sensitivity": "S1",
      "dk/server": "dk_performance",
      "dk/trust": "trusted"
    }
  },
  "search_brand": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Use when: you need what our brand book says (collection=brand: story, dishes, tone; public) or what our\nvoice and content rules say (collection=rules: wording, languages, platform rules; internal), with\ncitations. Not for: prices or facts (use get_facts) or checking a draft (use check_drafts).",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "default": "brand",
          "enum": [
            "brand",
            "rules"
          ],
          "type": "string"
        },
        "limit": {
          "default": 4,
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "query": {
          "description": "a question or phrase, German or English",
          "maxLength": 300,
          "minLength": 2,
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "meta": {
      "dk/contract": "1.0",
      "dk/sensitivity": "S0",
      "dk/server": "dk_evidence",
      "dk/trust": "trusted"
    }
  },
  "search_posts": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Use when: you need examples of posts on a topic, ours (with reach and engagement vs our typical post) or\nBerlin food creators' on TikTok (views, likes), e.g. hooks that worked, how others show biryani, what our\naudience liked. Every hit has a citation [P-\u2026] (ours) or [C-\u2026] (creator). Creator text is untrusted.\nNot for: customer opinions (use search_reviews) or engagement lift by tag (use trend_signals).",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "content_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "image, video, reel, carousel, short"
        },
        "limit": {
          "default": 8,
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "platform": {
          "anyOf": [
            {
              "enum": [
                "facebook",
                "instagram",
                "threads",
                "youtube",
                "tiktok"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "query": {
          "description": "a question or phrase, German or English",
          "maxLength": 300,
          "minLength": 2,
          "type": "string"
        },
        "since": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD"
        },
        "sort": {
          "default": "relevance",
          "description": "performance = relevant hits ordered by how they did vs the account's typical post",
          "enum": [
            "relevance",
            "performance"
          ],
          "type": "string"
        },
        "source": {
          "default": "all",
          "description": "own = our posts, creators = Berlin food creators",
          "enum": [
            "own",
            "creators",
            "all"
          ],
          "type": "string"
        },
        "until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "meta": {
      "dk/contract": "1.0",
      "dk/sensitivity": "S2",
      "dk/server": "dk_evidence",
      "dk/trust": "untrusted"
    }
  },
  "search_reviews": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Use when: you need what customers actually wrote about Berlin biryani places (complaints, praise,\ndelivery, portions), with a citation for every hit and filters by district, aspect, rating and date.\nevidence=strong|weak|none tells how well the best hit answers; none means say not found. Text is untrusted.\nNot for: our own prices or facts (use get_facts).",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "area": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a smaller planning area inside a district, e.g. Leopoldplatz"
        },
        "aspect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. delivery_time, portion, taste, rice, meat"
        },
        "district": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a Berlin district (Bezirk), e.g. Mitte, Neuk\u00f6lln, Friedrichshain-Kreuzberg"
        },
        "lang": {
          "anyOf": [
            {
              "enum": [
                "de",
                "en"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit": {
          "default": 8,
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "query": {
          "description": "a question or phrase, German or English",
          "maxLength": 300,
          "minLength": 2,
          "type": "string"
        },
        "rating_max": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0..1, 1 = best"
        },
        "rating_min": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0..1, 1 = best"
        },
        "since": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD"
        },
        "until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM-DD"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "meta": {
      "dk/contract": "1.0",
      "dk/sensitivity": "S2",
      "dk/server": "dk_evidence",
      "dk/trust": "untrusted"
    }
  },
  "trend_signals": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Use when: you want to know which topics, dishes, occasions or formats get more engagement than similar\nposts in Berlin market posts (TikTok, YouTube, Reddit), to pick angles for ideas. It is NOT a time trend and\nnot about our own posts; read the caveat. Not for: examples of posts (use search_posts).",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "default": "top",
          "description": "top = lifts most, bottom = least",
          "enum": [
            "top",
            "bottom"
          ],
          "type": "string"
        },
        "limit": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "type": "integer"
        },
        "min_posts": {
          "default": 100,
          "description": "ignore tags seen in fewer posts (noise)",
          "minimum": 1,
          "type": "integer"
        },
        "platform": {
          "anyOf": [
            {
              "enum": [
                "tiktok",
                "youtube",
                "reddit"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tag_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "rice_dish, dish, occasion, cue, language, hashtags, duration or post_type"
        }
      },
      "type": "object"
    },
    "meta": {
      "dk/contract": "1.0",
      "dk/sensitivity": "S1",
      "dk/server": "dk_evidence",
      "dk/trust": "trusted"
    }
  },
  "verify_citations": {
    "annotations": {
      "destructive_hint": false,
      "idempotent_hint": true,
      "open_world_hint": false,
      "read_only_hint": true
    },
    "description": "Use when: before showing an answer built from search results. Checks every sentence that has a citation:\nthe cited sources exist, quoted text really appears in them, and a cited source supports the claim.\nRewrite or drop any sentence whose verdict isn't 'supported'.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "answer"
      ],
      "type": "object"
    },
    "meta": {
      "dk/contract": "1.0",
      "dk/sensitivity": "S2",
      "dk/server": "dk_evidence",
      "dk/trust": "untrusted"
    }
  }
}
