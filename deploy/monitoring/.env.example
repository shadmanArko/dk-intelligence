# deploy/monitoring/.env (VPS only, mode 600). The Telegram token and chat id are read from deploy/.env by up.sh.
GRAFANA_ADMIN_PASSWORD=
# optional, for correct links in Grafana: https://<vps-name>.<tailnet>.ts.net:8443/
GRAFANA_ROOT_URL=
# host port for Grafana on 127.0.0.1 (default 3330; 3000 is used by another service on the VPS)
GRAFANA_PORT=3330
