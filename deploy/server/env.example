# Copy to /srv/apps/intel-weekly/weekly.env on the server (never commit it). Non-secret settings only.
GIT_SHA=0000000                 # git rev-parse --short HEAD of the checkout; also the image tag
MIP_DB_NETWORK=                 # docker network of the mip-postgres container
MIP_PG_HOST=                    # its container / service name on that network
RAG_DB_NETWORK=                 # docker network of the dk-rag container
RAG_PG_HOST=                    # its container / service name on that network
INTEL_API_URL=                  # same value as in the Mac's dk-intelligence .env (tailnet URL)
DK_WAREHOUSE_SSH=               # intel@<VPS tailscale ip>, same as the Mac
DK_INBOX_SSH=                   # intelinbox@<VPS tailscale ip>, same as the Mac
INTEL_SHIP_KNOWLEDGE=           # same as the Mac's .env (true/false)
INTEL_WEEKLY_SECRETS=/srv/apps/intel-weekly/secrets
INTEL_WEEKLY_KNOWN_HOSTS=/srv/apps/intel-weekly/known_hosts
#INTEL_WEEKLY_DATA=/srv/data/dk-intelligence
#MIP_REPO=/srv/apps/mip-weekly/repo
#MIP_DATA=/srv/data/mip-weekly
