      "post": {
        "operationId": "submit_v1_posts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Submit V1 Posts Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create a post (a draft unless approve is true)"
      }
    },
    "/v1/posts/batch": {
      "post": {
        "description": "Each post is checked and created like POST /v1/posts, on its own: one bad post never\nstops the others, and sending the same batch again is safe. Always drafts. A media entry\nmay be a media_id or a public https link (downloaded once).",
        "operationId": "batch_v1_posts_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchIn"
              }
            }
          },
          "required": true
