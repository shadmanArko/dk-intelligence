{
  "components": {
    "schemas": {
      "BatchIn": {
        "additionalProperties": false,
        "properties": {
          "dry_run": {
            "default": false,
            "description": "True: check every post and create nothing (linked files are downloaded so they can be checked).",
            "title": "Dry Run",
            "type": "boolean"
          },
          "posts": {
            "description": "1 to 20 posts; each is handled on its own.",
            "items": {
              "$ref": "#/components/schemas/PostIn"
            },
            "title": "Posts",
            "type": "array"
          }
        },
        "required": [
          "posts"
        ],
        "title": "BatchIn",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PostIn": {
        "additionalProperties": false,
        "properties": {
          "approve": {
            "default": false,
            "description": "False (default): create drafts that a person approves. True needs a key with approve rights.",
            "title": "Approve",
            "type": "boolean"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "An internal name; never published.",
            "title": "Label"
          },
          "post_key": {
            "description": "Your own unique id for this post. Sending the same post_key and content again is safe: you get the existing post back, never a second one.",
            "title": "Post Key",
            "type": "string"
          },
          "variants": {
            "items": {
              "$ref": "#/components/schemas/VariantIn"
            },
            "title": "Variants",
            "type": "array"
          }
        },
        "required": [
          "post_key",
          "variants"
        ],
        "title": "PostIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VariantIn": {
        "additionalProperties": false,
        "description": "One post on one platform. Anything not listed here is refused, so a typo is caught.",
        "properties": {
          "account": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Which connected account. Optional when only one is connected.",
            "title": "Account"
          },
          "caption": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The text of the post, if the format has one.",
            "title": "Caption"
          },
          "format": {
            "description": "A format of that platform, e.g. reel. See GET /v1/platforms.",
            "title": "Format",
            "type": "string"
          },
          "media": {
            "description": "Ids returned by POST /v1/media, in order.",
            "items": {
              "type": "string"
            },
            "title": "Media",
            "type": "array"
          },
          "options": {
            "additionalProperties": true,
            "description": "The format's extra fields, e.g. title or privacy_level.",
            "title": "Options",
            "type": "object"
          },
          "platform": {
            "description": "A platform key from GET /v1/platforms.",
            "title": "Platform",
            "type": "string"
          },
          "slot": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When to publish: ISO 8601 with a UTC offset, e.g. 2026-10-12T19:30:00+02:00.",
            "title": "Slot"
          }
        },
        "required": [
          "platform",
          "format"
        ],
        "title": "VariantIn",
        "type": "object"
      },
      "WebhookIn": {
        "additionalProperties": false,
        "properties": {
          "events": {
            "description": "Which events you want, e.g. post.published. Leave empty for all of them.",
            "items": {
              "type": "string"
            },
            "title": "Events",
            "type": "array"
          },
          "url": {
            "description": "Where to send messages. https only, a public host.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "title": "WebhookIn",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Schedule social posts. Read GET /v1/platforms to learn what each platform accepts, POST /v1/posts/validate to check a post without creating it, then POST /v1/posts. Every error says what to fix. Plain-text guide for agents: GET /llms.txt.",
    "title": "DK Publishing API",
    "version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/calendar": {
      "get": {
        "description": "Posts from the Sheet and the API, narrowed by state, platform, source (sheet, api)\nand dates (ISO 8601 with an offset). Newest first when state=published.",
        "operationId": "status_calendar_v1_calendar_get",
        "parameters": [
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "State"
            }
          },
          {
            "in": "query",
            "name": "platform",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Platform"
            }
          },
          {
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          },
          {
            "in": "query",
            "name": "from",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "From"
            }
          },
          {
            "in": "query",
            "name": "to",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "To"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Status Calendar V1 Calendar Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Every post by slot; state=published is the history"
      }
    },
    "/v1/media": {
      "post": {
        "description": "Send the file itself as the request body with `?filename=reel.mp4`, or send JSON\n`{\"url\": \"https://...\", \"filename\": \"reel.mp4\"}` and the server downloads it.",
        "operationId": "add_media_v1_media_post",
        "parameters": [
          {
            "in": "query",
            "name": "filename",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Filename"
            }
          }
        ],
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Add Media V1 Media Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Add a file (bytes, or a public https link)"
      }
    },
    "/v1/overview": {
      "get": {
        "description": "Every post, the Google Sheet's too: what waits, what is coming, what went out in the\nlast `days_back` days, what needs a look, and the last slot that is planned.",
        "operationId": "status_overview_v1_overview_get",
        "parameters": [
          {
            "in": "query",
            "name": "days_back",
            "required": false,
            "schema": {
              "default": 7,
              "title": "Days Back",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "days_ahead",
            "required": false,
            "schema": {
              "default": 14,
              "title": "Days Ahead",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Status Overview V1 Overview Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Where publishing stands: pipeline, published, problems"
      }
    },
    "/v1/platforms": {
      "get": {
        "operationId": "platforms_v1_platforms_get",
        "responses": {
          "200": {
