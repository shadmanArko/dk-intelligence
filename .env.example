# Copy to .env and fill in. Never commit .env.

# Live warehouse on the VPS, read-only role, reached through the SSH tunnel below.
# Passwords with special characters must be URL-encoded (@ -> %40).
DK_WAREHOUSE_DSN=postgresql://intelligence_reader:CHANGE_ME@127.0.0.1:5435/warehouse
# Tunnel-only SSH user (can only forward to the VPS database port, only from the Mac's Tailscale IP)
DK_WAREHOUSE_SSH=intel@100.92.213.30
DK_WAREHOUSE_SSH_KEY=/Users/you/.ssh/dk_intel_tunnel

# Model inbox on the VPS (door 2): upload-only user, forced rrsync -wo into one folder, only from the Mac
DK_INBOX_SSH=intelinbox@100.92.213.30
DK_INBOX_SSH_KEY=/Users/you/.ssh/dk_intel_inbox

# Market data platform (local Postgres, read-only role mip_reader) - used from M3
MIP_READER_DSN=postgresql://mip_reader:CHANGE_ME@localhost:5434/mip

# Where pulls, models and runs are stored (git-ignored)
INTEL_DATA_DIR=data
# How many old warehouse pulls to keep
INTEL_KEEP_PULLS=12

# intel-api over the tailnet (training's live gate, and the MCP server's dk_models tools)
INTEL_API_URL=https://your-vps.your-tailnet.ts.net

# MCP server (Phase 4, ADR 0025). All optional; defaults shown.
# INTEL_MCP_AUDIT_DIR=data/mcp/audit
# INTEL_PACK_DIR=data/knowledge
# INTEL_MCP_DISABLED_TOOLS=          # kill switch, e.g. score_drafts,find_creators
